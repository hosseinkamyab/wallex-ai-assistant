# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
#
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# `.env` is git-ignored, so it will never be committed. This example file
# contains placeholders only -- never put real credentials in it.
# ---------------------------------------------------------------------------

# --- Wallex ---------------------------------------------------------------
# Your Wallex API key. Only needed for account data (balances, order history).
# Public market prices work WITHOUT a key, so you can leave this empty while
# you are still experimenting.
#
# Create one at: Wallex website -> your profile -> API management.
# Give it READ-ONLY permission if Wallex offers that option.
WALLEX_API_KEY=

# Base URL of the Wallex API. You should not need to change this.
WALLEX_BASE_URL=https://api.wallex.ir

# --- Application ----------------------------------------------------------
# Log verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Interface language: en (English) or fa (Persian / فارسی).
APP_LANGUAGE=en

# HTTP timeout in seconds, and how many times to retry a failed request.
REQUEST_TIMEOUT=15
MAX_RETRIES=3

# --- LLM (AI analysis) ----------------------------------------------------
# Stage 4 of the project builds the AI layer. For now the provider is "mock",
# which produces sample analysis locally without calling any external service
# and without needing a key.
LLM_PROVIDER=mock

# Only needed once you switch LLM_PROVIDER to a real provider (e.g. anthropic).
LLM_API_KEY=
